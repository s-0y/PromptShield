# Copy to .env. Process environment variables take precedence.
# mock = offline pipeline check; api = real, potentially billable model call.
PROMPTSHIELD_PROVIDER=mock
PROMPTSHIELD_BASE_URL=https://api.openai.com/v1
# Set an exact Chat Completions model ID available in your API account.
PROMPTSHIELD_MODEL=
PROMPTSHIELD_API_KEY=
# OPENAI_API_KEY is also accepted if PROMPTSHIELD_API_KEY is empty.
PROMPTSHIELD_TIMEOUT_SECONDS=60
PROMPTSHIELD_MAX_COMPLETION_TOKENS=1024
# Blank omits temperature so models with a fixed value can be used.
# Only set it if the selected model supports it; keep it fixed across experiments.
PROMPTSHIELD_TEMPERATURE=
